public open(uiId: string, uiLayer: UILayer, ...params: any[]): void {
        const config = UI_CONFIG[uiId];
        assert(!!config, `config is not exist,plz check uiId:${uiId}`)
        let uiInstance = this.uiInstances.get(uiId);
        if (!uiInstance) {
            const instanceId = this.genInstanceId(config)
            UIFactory.loadAndCreateUI(config)
                .then((loadedUIInstance) => {
                    this.uiInstances.set(instanceId, loadedUIInstance);
                    this.addUIToLayer(loadedUIInstance, uiLayer);
                    loadedUIInstance.name = instanceId
                    let mediator = MediatorFactory.create(config.mediatorClass, loadedUIInstance);
                    this.mediators.set(instanceId, mediator);
                    mediator.initialize(instanceId);
                    mediator.open(...params);
                })
                .catch((error) => {
                    // 处理加载或创建UI实例时出现的错误
                });
        } 
    }





    个性特征：
给AI设计不同的个性，比如勇猛、聪明、贪婪或好奇。这些特质可以影响它们的行为和决策。
发展系统：
允许AI随着时间和经验提升级别，学习新技能或根据玩家的偏好进行自我优化。
决策能力：
AI之间的差异化可以让玩家根据自己的策略和游戏风格选择不同的AI。
交互关系：
设计AI可以彼此交流、学习或竞争，即使没有玩家的直接控制。

提供AI的试用，让玩家在购买前可以体验AI的效果，这可以刺激玩家的购买意愿。


步骤1：定义AI行为模式
首先，需要为AI定义不同的行为模式或策略，比如：
探索者：喜爱探索地图，寻找隐藏的物品和秘密通道。
战斗家：擅长战斗，会寻找最佳战斗策略对抗敌人。
收集者：专注于收集资源和物品。
社交者：与游戏内的NPC互动，获取任务和情报。
步骤2：构建AI梯次层级
设计不同层级的AI，比如：
入门级：执行基础操作，适合新手玩家。
中级：拥有更复杂的决策能力，适合有一定游戏经验的玩家。
高级：能够执行高度复杂的策略和任务，适合高级玩家或那些想要挑战的人。
步骤3：AI定制化
让玩家能够通过购买和组合不同的AI模块来定制他们的角色，例如：
战斗模块：提高角色的战斗能力。
防御模块：增强角色的防御和生存能力。
策略模块：提升角色在战斗中使用技能的智能程度。
社交模块：提高角色与NPC交流的效率，获取更好的任务和交易。
步骤4：AI习得和进化
允许AI角色通过经验获得新的技能或升级现有技能，AI可以因此变得更加灵活和有效。
步骤5：添加AI个性和随机性
为AI角色添加独特的个性特征，比如勇敢、好奇或保守。
在AI决策中加入一定的随机性，以创造出不可预测的玩法和更加真实的游戏体验。
步骤6：平衡和调整
根据玩家反馈对AI进行调整，以确保不同层级的AI都能提供有趣的游戏体验而不失平衡。
设立系统来不断检测和调整AI的性能，保证游戏的长期趣味性和挑战性。
步骤7：社区参与
可以允许玩家分享他们的AI配置，并与其他玩家竞争或合作。
创建玩家论坛或社交媒体群组，让玩家交流AI使用策略和体验。




入门级AI：
助手式AI：这类AI可以执行些基本的操作，如接收并完成简单的任务（如收集资源、清理道路障碍等），并回报给玩家。
战斗初级AI：这类AI具有基础的战斗能力，可以自行对抗低级的敌人，但可能无法处理较复杂的战斗情景。
交互初级AI：这类AI可以与NPC共享基本的交互，如简单的对话和交换物品。
中级AI：
策略型AI：这类AI可以做出较复杂的决策，例如他们可以根据环境和情况选择不同的战略或技能。
社交化AI：这类AI能够更好地和NPC交互，获取更有价值的信息和任务。
探索者AI：这类AI具备更好的寻路和探索能力，他们可以找到隐藏的道路或物品，或者揭示地图中的秘密地点。
高级AI：
指挥官AI：这类AI可以领导和指挥其他AI或者NPC，进行分组行动或协同任务。
专家战士AI：这类AI具有最高级的战斗技能，包括复杂的打击和防御操作，能够对战场和战术进行全面的评估。
贸易大亨AI：这类AI是绝佳的交易者，能够用较低的价格购买物品，或以较高的价格销售物品，从而最大限度地提高玩家的收益。