enum ModifierFunction {
    MODIFIER_PROPERTY_BASEATTACK_BONUSDAMAGE = 0,
    MODIFIER_PROPERTY_STATS_STRENGTH_BONUS = 1,
    MODIFIER_PROPERTY_TOTALDAMAGEOUTGOING_PERCENTAGE = 2,
    // ... 其他修饰器函数
}

type ModifierValue = number | ((entity: ECSEntity) => number);

class Modifier {
    constructor(
        public id: string,
        public duration: number = Infinity,
        public isHidden: boolean = false,
        public isDebuff: boolean = false,
        public purgable: boolean = true,
        public priority: number = 0
    ) {}

    private modifiers: Map<ModifierFunction, ModifierValue> = new Map();

    addModifierFunction(func: ModifierFunction, value: ModifierValue) {
        this.modifiers.set(func, value);
    }

    getModifierValue(func: ModifierFunction, entity: ECSEntity): number {
        const value = this.modifiers.get(func);
        if (value === undefined) return 0;
        return typeof value === 'function' ? value(entity) : value;
    }
}

class BuffManager {
    private modifiers: Map<ECSEntity, Modifier[]> = new Map();
    private cache: Map<ECSEntity, Map<ModifierFunction, number>> = new Map();
    private dirty: Set<ECSEntity> = new Set();

    addModifier(entity: ECSEntity, modifier: Modifier) {
        if (!this.modifiers.has(entity)) {
            this.modifiers.set(entity, []);
        }
        const entityModifiers = this.modifiers.get(entity)!;
        entityModifiers.push(modifier);
        entityModifiers.sort((a, b) => b.priority - a.priority);
        this.markDirty(entity);
    }

    removeModifier(entity: ECSEntity, modifierId: string) {
        const entityModifiers = this.modifiers.get(entity);
        if (entityModifiers) {
            const index = entityModifiers.findIndex(m => m.id === modifierId);
            if (index !== -1) {
                entityModifiers.splice(index, 1);
                this.markDirty(entity);
            }
        }
    }

    private markDirty(entity: ECSEntity) {
        this.dirty.add(entity);
        this.cache.delete(entity);
    }

    getModifierValue(entity: ECSEntity, func: ModifierFunction): number {
        if (this.dirty.has(entity)) {
            this.recalculateCache(entity);
        }

        const entityCache = this.cache.get(entity);
        if (entityCache && entityCache.has(func)) {
            return entityCache.get(func)!;
        }

        return this.calculateModifierValue(entity, func);
    }

    private recalculateCache(entity: ECSEntity) {
        const entityCache = new Map<ModifierFunction, number>();
        this.cache.set(entity, entityCache);

        const entityModifiers = this.modifiers.get(entity) || [];
        for (const modifier of entityModifiers) {
            for (const func of modifier.modifiers.keys()) {
                const value = this.calculateModifierValue(entity, func);
                entityCache.set(func, value);
            }
        }

        this.dirty.delete(entity);
    }

    private calculateModifierValue(entity: ECSEntity, func: ModifierFunction): number {
        const entityModifiers = this.modifiers.get(entity) || [];
        return entityModifiers.reduce((total, modifier) => {
            return total + modifier.getModifierValue(func, entity);
        }, 0);
    }
}

interface ECSEntity {
    getLevel(): number;
}

class Hero implements ECSEntity {
    constructor(
        public baseAttack: number,
        public baseStrength: number,
        private level: number
    ) {}

    getLevel(): number {
        return this.level;
    }
}

// 使用示例
const buffManager = new BuffManager();
const sven = new Hero(65, 30, 16);

// 添加属性加成modifier (高优先级)
const attributeBonus = new Modifier("attribute_bonus", Infinity, false, false, false, 100);
attributeBonus.addModifierFunction(ModifierFunction.MODIFIER_PROPERTY_STATS_STRENGTH_BONUS, 30);
buffManager.addModifier(sven, attributeBonus);

// 添加装备加成modifier (中等优先级)
const daedalus = new Modifier("item_daedalus", Infinity, false, false, true, 50);
daedalus.addModifierFunction(ModifierFunction.MODIFIER_PROPERTY_BASEATTACK_BONUSDAMAGE, 88);
buffManager.addModifier(sven, daedalus);

// 添加God's Strength buff (低优先级)
const godsStrength = new Modifier("gods_strength", 25, false, false, true, 10);
godsStrength.addModifierFunction(
    ModifierFunction.MODIFIER_PROPERTY_TOTALDAMAGEOUTGOING_PERCENTAGE,
    (entity: ECSEntity) => {
        const level = entity.getLevel();
        if (level < 11) return 80;
        if (level < 16) return 120;
        return 160;
    }
);
buffManager.addModifier(sven, godsStrength);

function calculateFinalAttack(hero: Hero, buffManager: BuffManager): number {
    const baseAttack = hero.baseAttack;
    const strengthBonus = buffManager.getModifierValue(hero, ModifierFunction.MODIFIER_PROPERTY_STATS_STRENGTH_BONUS);
    const attackBonus = buffManager.getModifierValue(hero, ModifierFunction.MODIFIER_PROPERTY_BASEATTACK_BONUSDAMAGE);
    const damagePercentage = buffManager.getModifierValue(hero, ModifierFunction.MODIFIER_PROPERTY_TOTALDAMAGEOUTGOING_PERCENTAGE);

    let attack = baseAttack + strengthBonus + attackBonus;
    attack *= (1 + damagePercentage / 100);

    return Math.floor(attack);
}

const finalAttack = calculateFinalAttack(sven, buffManager);
console.log(`Sven's final attack at level ${sven.getLevel()}: ${finalAttack}`);


主要的优化点：
缓存机制：
添加了 cache 和 dirty 属性来管理缓存。
markDirty 方法用于标记需要重新计算的实体。
recalculateCache 方法用于重新计算并缓存修饰器值。
getModifierValue 方法现在首先检查缓存，只有在必要时才重新计算。
优先级系统：
在 Modifier 类中添加了 priority 属性。
在 addModifier 方法中，根据优先级对修饰器进行排序。
修饰器按优先级从高到低应用，确保重要的修饰器（如属性加成）先应用。
性能优化：
只有在实体被标记为"脏"时才重新计算缓存。
缓存按实体和修饰器函数分别存储，允许细粒度的更新。
灵活性：
可以轻松地为不同的修饰器设置不同的优先级。
缓存机制可以处理任何类型的修饰器函数。
这种实现方式有以下优点：
高性能：通过缓存机制，避免了不必要的重复计算。
准确性：优先级系统确保修饰器按正确的顺序应用。
灵活性：可以轻松添加新的修饰器类型和优先级。
可维护性：代码结构清晰，易于理解和扩展。
通过这些优化，系统可以更高效地处理大量实体和复杂的修饰器组合，同时保持了代码的清晰度和可维护性。这种实现非常适合像DOTA 2这样的复杂游戏系统，可以有效地管理各种buff和debuff。