// invisibility.effect

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        outlineColor:   { value: [0.5, 0.5, 1, 1], editor: { type: color } }
        outlineWidth:   { value: 0.02, range: [0.0, 0.1] }
        waveSpeed:      { value: 2.0 }
        waveAmplitude:  { value: 0.05 }
        time:           { value: 0.0 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  void main () {
    vec4 pos = vec4(a_position, 1);
    pos = cc_matViewProj * pos;
    v_uv0 = a_texCoord;
    v_color = a_color;
    gl_Position = pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <cc-global>

  in vec4 v_color;
  in vec2 v_uv0;

  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
    vec4 outlineColor;
    float outlineWidth;
    float waveSpeed;
    float waveAmplitude;
    float time;
  };

  void main () {
    vec4 o = vec4(1, 1, 1, 1);
    vec4 texture_color = texture(mainTexture, v_uv0);
    
    // 基础颜色
    o *= texture_color;
    o *= v_color;
    o *= mainColor;

    // 轮廓效果
    float edge = 1.0 - texture_color.a;
    vec2 uv = v_uv0;
    float outline = smoothstep(1.0 - outlineWidth, 1.0, edge);
    
    // 波动效果
    float wave = sin(time * waveSpeed + uv.y * 10.0) * waveAmplitude;
    uv.x += wave;
    
    vec4 waveColor = texture(mainTexture, uv);
    o = mix(o, outlineColor, outline);
    o = mix(o, waveColor, 0.5);

    gl_FragColor = o;
  }
}%
