// ice-freezing.effect

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        iceColor:       { value: [0.7, 0.9, 1, 1], editor: { type: color } }
        freezeIntensity: { value: 0.5, range: [0.0, 1.0] }
        noiseScale:     { value: 10.0 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  void main () {
    vec4 pos = vec4(a_position, 1);
    pos = cc_matViewProj * pos;
    v_uv0 = a_texCoord;
    v_color = a_color;
    gl_Position = pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <cc-global>

  in vec4 v_color;
  in vec2 v_uv0;

  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
    vec4 iceColor;
    float freezeIntensity;
    float noiseScale;
  };

  // 简单的噪声函数
  float noise(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
  }

  void main () {
    vec4 o = vec4(1, 1, 1, 1);
    vec4 texture_color = texture(mainTexture, v_uv0);
    
    // 基础颜色
    o *= texture_color;
    o *= v_color;
    o *= mainColor;

    // 冰冻效果
    float n = noise(v_uv0 * noiseScale);
    vec3 iceEffect = mix(o.rgb, iceColor.rgb, n * freezeIntensity);
    o.rgb = mix(o.rgb, iceEffect, freezeIntensity);

    // 添加一些冰晶效果
    float iceCrystal = step(0.97, n);
    o.rgb = mix(o.rgb, vec3(1.0), iceCrystal * freezeIntensity);

    gl_FragColor = o;
  }
}%
