// astral-spirit.effect

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        glowColor:      { value: [0, 0.5, 1, 1], editor: { type: color } }
        glowIntensity:  { value: 0.5, range: [0.0, 1.0] }
        waveSpeed:      { value: 2.0 }
        waveAmplitude:  { value: 0.1 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  void main () {
    vec4 pos = vec4(a_position, 1);
    pos = cc_matViewProj * pos;
    v_uv0 = a_texCoord;
    v_color = a_color;
    gl_Position = pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <cc-global>

  in vec4 v_color;
  in vec2 v_uv0;

  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
    vec4 glowColor;
    float glowIntensity;
    float waveSpeed;
    float waveAmplitude;
  };

  void main () {
    vec4 o = vec4(1, 1, 1, 1);
    vec4 texture_color = texture(mainTexture, v_uv0);
    
    // 基础颜色
    o *= texture_color;
    o *= v_color;
    o *= mainColor;

    // 边缘发光
    float edge = 1.0 - texture_color.a;
    vec3 glow = glowColor.rgb * edge * glowIntensity;
    o.rgb += glow;

    // 颜色波动
    float wave = sin(cc_time.x * waveSpeed + v_uv0.y * 10.0) * waveAmplitude;
    o.rgb += wave * glowColor.rgb;

    gl_FragColor = o;
  }
}%
