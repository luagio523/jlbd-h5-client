// FogShader.effect

CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: sprite-vs
      frag: sprite-fs
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      properties:
        cameraPosition: { value: [0.0, 0.0] }
        revealInfo: { value: [0.0, 0.0, 0.0] } # 中心点和半径
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;

  void main() {
    uv0 = a_texCoord;
    color = a_color;
    gl_Position = cc_matViewProj * vec4(a_position, 1.0);
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec4 color;
  in vec2 uv0;

  uniform sampler2D cc_spriteTexture;
  uniform vec2 cameraPosition;
  uniform vec3 revealInfo;

  void main() {
    vec4 texColor = texture(cc_spriteTexture, uv0);
    float distance = length(gl_FragCoord.xy - cameraPosition);
    
    // 判断当前片元是否在揭示区域内
    if (distance < revealInfo.z) {
      discard; // 丢弃该片元,表示该区域被揭示
    }

    // 设置迷雾颜色
    gl_FragColor = vec4(0.0, 0.0, 0.0, 0.8); // 迷雾颜色,黑色半透明
  }
}%
